{
  "permissions": {
    "deny": [
      "Bash(sudo*)",
      "Bash(ssh*)",
      "Bash(*chmod 777*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf*)",
      "Bash(*> /dev/*)",
      "Edit(Cargo.toml)",
      "Edit(Cargo.lock)",
      "Edit(package.json)",
      "Edit(package-lock.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre_tool_use_deny.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre_tool_use_deny.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/post_tool_use_lint.py"
          }
        ]
      }
    ]
  }
}
